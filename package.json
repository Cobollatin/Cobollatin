{
  "name": "cobollatin",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.8"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare": "husky",
    "postinstall": "astro sync",
    "astro": "astro",
    "sync": "astro sync",
    "check": "astro check",
    "check:i18n": "bun scripts/check-i18n-posts.ts",
    "format": "eslint . --fix && stylelint 'src/**/*.{css,scss}' --fix && prettier --write .",
    "lint": "eslint . && stylelint 'src/**/*.{css,scss}' && prettier --check .",
    "test": "vitest run --run --coverage",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "new:post": "bun scripts/new-post.ts",
    "ncu": "bunx npm-check-updates -u && bun install"
  },
  "dependencies": {
