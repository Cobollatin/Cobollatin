{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "develop": false,
      "feat/*": true,
      "features/*": true,
      "fix/*": true,
      "*": false
    }
  }
}
