---
import { localePath, locales, messages, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const t = messages[locale];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} · Cobollatin</title>
  </head>
  <body>
    <a class="skip" href="#main">{locale === 'es' ? 'Ir al contenido' : 'Skip to content'}</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={localePath(locale)} aria-label="Cobollatin home">Cobollatin<span class="brand-mark">.</span></a>
        <nav aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
          <a href={localePath(locale)}>{t.home}</a>
          <a href={localePath(locale, 'blog/')}>{t.blog}</a>
          <a href={localePath(locale, 'tools/')}>{t.tools}</a>
        </nav>
        <div class="languages" aria-label={locale === 'es' ? 'Idioma' : 'Language'}>
          {locales.map((choice) => <a href={localePath(choice)} aria-current={choice === locale ? 'true' : undefined}>{choice.toUpperCase()}</a>)}
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><span>Cobollatin</span><span>{locale === 'es' ? 'Hecho con Astro' : 'Built with Astro'}</span></footer>
    </div>
  </body>
</html>
