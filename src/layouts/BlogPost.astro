---
import { type CollectionEntry, getEntry } from 'astro:content';

import type { Locale } from '../i18n/locales';

import { t } from '../i18n/messages';
import { localizePath, stripLocaleFromPath } from '../i18n/routing';
import BaseHead from '../components/site/BaseHead.astro';
import Footer from '../components/site/Footer.astro';
import FormattedDate from '../components/site/FormattedDate.astro';
import Header from '../components/site/Header.astro';

interface LayoutProps extends Props {
  locale?: Locale;
}

type Props = CollectionEntry<'blog'>['data'];

const { locale: inferredLocale } = stripLocaleFromPath(Astro.url.pathname);
const {
  authors = [],
  description,
  heroImage,
  locale = inferredLocale,
  pubDate,
  title,
  updatedDate,
} = Astro.props as LayoutProps;

type AuthorEntry = CollectionEntry<'authors'>;
type AuthorLink = AuthorEntry['data']['links'][number];

const authorIds = ((authors ?? []) as string[]).map((id: string) => id.trim()).filter(Boolean);
const resolvedAuthors = (await Promise.all(authorIds.map((id: string) => getEntry('authors', id)))).filter(
  (author): author is AuthorEntry => Boolean(author),
);

const site = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = new URL(localizePath(Astro.url.pathname, locale), site);
const absoluteHeroImageURL = new URL(heroImage ?? '/blog-placeholder-1.jpg', site);

function isExternalHref(href: string): boolean {
  return /^https?:\/\//i.test(href);
}

function resolveHref(href: string): string {
  if (href.startsWith('/')) return localizePath(href, locale);
  return href;
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  author: resolvedAuthors.map((author) => ({
    '@type': 'Person',
    name: author.data.name,
    sameAs: author.data.links.filter((link: AuthorLink) => isExternalHref(link.href)).map((link: AuthorLink) => link.href),
  })),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  datePublished: pubDate.toISOString(),
  description,
  headline: title,
  image: absoluteHeroImageURL.toString(),
  inLanguage: locale,
  mainEntityOfPage: canonicalURL.toString(),
  publisher: { '@id': new URL('#person', site).toString() },
  url: canonicalURL.toString(),
};

const articleSchemaJson = JSON.stringify(articleSchema);
---

<html lang={locale}>
  <head>
    <BaseHead
      description={description}
      image={heroImage ?? '/blog-placeholder-1.jpg'}
      imageAlt={title}
      locale={locale}
      ogType="article"
      title={title}
    />
    <meta content={pubDate.toISOString()} property="article:published_time" />
    {updatedDate && <meta content={updatedDate.toISOString()} property="article:modified_time" />}
    <script is:inline set:html={articleSchemaJson} type="application/ld+json"></script>
    <style>
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto 1rem;
        border: 1px solid var(--border);
      }
      .prose {
        max-width: 720px;
        margin: 0 auto;
      }
      .title {
        margin-bottom: 1em;
        padding: 0.5rem 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
      }
      .date {
        margin-bottom: 0.5em;
        color: var(--muted);
      }
      .last-updated-on {
        font-style: italic;
      }
      .byline {
        margin-top: 0.35rem;
        color: var(--muted);
        font-size: 0.95rem;
      }
      .post-authors {
        max-width: 720px;
        margin: 2rem auto 0;
        border-top: 1px solid var(--border);
        padding-top: 1.25rem;
      }
      .post-authors__list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1rem;
      }
      .post-authors__card {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        padding: 1rem;
        border: 1px solid var(--border);
        background: var(--panel);
      }
      .post-authors__avatar {
        border-radius: 999px;
        border: 1px solid var(--border);
        flex: 0 0 auto;
      }
      .post-authors__name {
        margin: 0;
        font-size: 1.05rem;
      }
      .post-authors__role {
        margin: 0.15rem 0 0;
        color: var(--muted);
        font-size: 0.95rem;
      }
      .post-authors__summary {
        margin: 0.35rem 0 0;
        color: var(--muted);
      }
      .post-authors__links {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .post-authors__links a {
        color: var(--link);
        text-decoration: none;
        font-weight: 600;
      }
      .post-authors__links a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <Header locale={locale} />
    <main id="main-content">
      <article>
        <div class="hero-image">
          {heroImage && <img alt={title} height={510} src={heroImage} width={1020} />}
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    {t(locale, 'blog.lastUpdatedOn')} <FormattedDate date={updatedDate} />
                  </div>
                )
              }
              {
                resolvedAuthors.length > 0 && (
                  <div class="byline">
                    {t(locale, 'blog.by')}{' '}
                    {resolvedAuthors.map((author, index) => (
                      <>
                        {index > 0 ? ', ' : ''}
                        <a href={localizePath('/authors', locale)}>{author.data.name}</a>
                      </>
                    ))}
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>

        {
          resolvedAuthors.length > 0 && (
            <aside aria-label={t(locale, 'nav.authors')} class="post-authors">
              <ol class="post-authors__list">
                {resolvedAuthors.map((author) => (
                  <li>
                    <article class="post-authors__card">
                      {author.data.avatar && (
                        <img
                          alt={author.data.name}
                          class="post-authors__avatar"
                          height="56"
                          loading="lazy"
                          src={author.data.avatar}
                          width="56"
                        />
                      )}

                      <div>
                        <h2 class="post-authors__name">{author.data.name}</h2>
                        {author.data.role && <p class="post-authors__role">{author.data.role}</p>}
                        <p class="post-authors__summary">{author.data.summary}</p>

                        {author.data.links.length > 0 && (
                          <ul aria-label={`${author.data.name} links`} class="post-authors__links">
                            {author.data.links.map((link: AuthorLink) => {
                              const external = isExternalHref(link.href);
                              const href = resolveHref(link.href);
                              return (
                                <li>
                                  <a
                                    href={href}
                                    rel={external ? 'noreferrer noopener' : undefined}
                                    target={external ? '_blank' : undefined}
                                  >
                                    {link.label}
                                    {external && <span class="sr-only"> ({t(locale, 'ui.opensInNewTab')})</span>}
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        )}
                      </div>
                    </article>
                  </li>
                ))}
              </ol>
            </aside>
          )
        }
      </article>
    </main>
    <Footer />
  </body>
</html>
