---
import { SITE_TITLE } from '../../consts';
import { type Locale, locales } from '../../i18n/locales';
import { t } from '../../i18n/messages';
import { localizePath, stripLocaleFromPath } from '../../i18n/routing';
import HeaderLink from './HeaderLink.astro';

interface Props {
  locale?: Locale;
}

const { locale: inferredLocale, pathname } = stripLocaleFromPath(Astro.url.pathname);
const { locale = inferredLocale } = Astro.props as Props;
---

<header>
  <a class="skip-link" href="#main-content">{t(locale, 'ui.skipToContent')}</a>
  <nav aria-label="Primary">
    <div class="brand">
      <a class="brand__link" href={localizePath('/', locale)}>{SITE_TITLE}</a>
    </div>

    <div class="internal-links">
      <HeaderLink href={localizePath('/', locale)}>{t(locale, 'nav.home')}</HeaderLink>
      <HeaderLink href={localizePath('/blog', locale)}>{t(locale, 'nav.blog')}</HeaderLink>
      <HeaderLink href={localizePath('/authors', locale)}>{t(locale, 'nav.authors')}</HeaderLink>
      <HeaderLink href={localizePath('/about', locale)}>{t(locale, 'nav.about')}</HeaderLink>
    </div>

    <div class="controls">
      <div class="language-switcher">
        <label class="sr-only" for="lang-select">{t(locale, 'ui.language')}</label>
        <select id="lang-select" name="lang">
          {
            locales.map((targetLocale) => (
              <option selected={targetLocale === locale} value={localizePath(pathname, targetLocale)}>
                {t(targetLocale, 'languageName')}
              </option>
            ))
          }
        </select>
      </div>

      <button
        aria-label={t(locale, 'ui.toggleTheme')}
        data-label-dark={t(locale, 'ui.themeDark')}
        data-label-light={t(locale, 'ui.themeLight')}
        id="theme-toggle"
        type="button"
      >
        {t(locale, 'ui.themeLight')}
      </button>
    </div>
  </nav>

  <script is:inline>
    (() => {
      const storageKey = 'cobollatin-theme';

      const languageSelect = document.getElementById('lang-select');
      if (languageSelect instanceof HTMLSelectElement) {
        languageSelect.addEventListener('change', () => {
          const next = languageSelect.value;
          if (next) window.location.assign(next);
        });
      }

      const button = document.getElementById('theme-toggle');
      if (!(button instanceof HTMLButtonElement)) return;

      const labels = {
        dark: button.dataset.labelDark || 'Theme: Dark',
        light: button.dataset.labelLight || 'Theme: Light',
      };

      const getTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

      const render = (theme) => {
        button.textContent = labels[theme];
        button.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
      };

      const setTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem(storageKey, theme);
        } catch {
          // Ignore storage access failures
        }
        render(theme);
      };

      render(getTheme());
      button.addEventListener('click', () => setTheme(getTheme() === 'dark' ? 'light' : 'dark'));
    })();
  </script>
</header>

<style>
  header {
    margin: 0;
    padding: 0 1rem;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.4rem 0.6rem;
    background: var(--panel);
    border: 2px solid var(--focus);
    transform: translateY(-250%);
    transition: transform 0.15s ease;
    z-index: 50;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .brand__link {
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
  }

  .internal-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  select,
  button {
    font: inherit;
    color: var(--text);
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 0.25rem 0.5rem;
  }

  button {
    cursor: pointer;
  }

  button:focus,
  select:focus {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    nav {
      flex-wrap: wrap;
      justify-content: center;
    }

    .brand {
      width: 100%;
      text-align: center;
    }
  }
</style>
