---
import { SITE_TITLE, SOCIAL_LINKS } from '../../consts';
import SocialIcon from './SocialIcon';

const today = new Date();
---

<footer>
  <div class="footer__inner">
    <small>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</small>
    <div aria-label="Social links" class="social-links">
      {
        SOCIAL_LINKS.map((link) => (
          <a aria-label={link.label} href={link.href} rel="noreferrer noopener" target="_blank" title={link.label}>
            <span class="sr-only">{link.label}</span>
            <SocialIcon label={link.label} />
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 1rem 4rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .footer__inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .social-links a:hover {
    color: var(--text);
  }
</style>
