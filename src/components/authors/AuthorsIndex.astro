---
import type { CollectionEntry } from 'astro:content';

import type { Locale } from '../../i18n/locales';

import { t } from '../../i18n/messages';
import { localizePath } from '../../i18n/routing';

type AuthorEntry = CollectionEntry<'authors'>;
type AuthorLink = AuthorEntry['data']['links'][number];

interface Props {
  authors: AuthorEntry[];
  locale: Locale;
}

const { authors, locale } = Astro.props as Props;

function isExternalHref(href: string): boolean {
  return /^https?:\/\//i.test(href);
}

function resolveHref(href: string): string {
  if (href.startsWith('/')) return localizePath(href, locale);
  return href;
}
---

<section class="authors-index">
  <header class="authors-index__header">
    <h1>{t(locale, 'nav.authors')}</h1>
  </header>

  <ol class="authors-index__list">
    {
      authors.map((author) => (
        <li class="authors-index__item">
          <article class="authors-index__card">
            {author.data.avatar && (
              <img
                alt={author.data.name}
                class="authors-index__avatar"
                height="56"
                loading="lazy"
                src={author.data.avatar}
                width="56"
              />
            )}

            <div class="authors-index__content">
              <header class="authors-index__meta">
                <h2 class="authors-index__name">{author.data.name}</h2>
                {author.data.role && <p class="authors-index__role">{author.data.role}</p>}
              </header>

              <p class="authors-index__summary">{author.data.summary}</p>

              {author.data.links.length > 0 && (
                <ul aria-label={`${author.data.name} links`} class="authors-index__links">
                  {author.data.links.map((link: AuthorLink) => {
                    const external = isExternalHref(link.href);
                    const href = resolveHref(link.href);
                    return (
                      <li class="authors-index__link">
                        <a
                          href={href}
                          rel={external ? 'noreferrer noopener' : undefined}
                          target={external ? '_blank' : undefined}
                        >
                          {link.label}
                          {external && <span class="sr-only"> ({t(locale, 'ui.opensInNewTab')})</span>}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .authors-index__header {
    margin-bottom: 1rem;
  }

  .authors-index__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .authors-index__card {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid var(--border);
    background: var(--panel);
  }

  .authors-index__avatar {
    border-radius: 999px;
    border: 1px solid var(--border);
    flex: 0 0 auto;
  }

  .authors-index__meta {
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .authors-index__name {
    margin: 0;
    font-size: 1.1rem;
  }

  .authors-index__role {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .authors-index__summary {
    margin: 0.35rem 0 0;
    color: var(--muted);
  }

  .authors-index__links {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .authors-index__link a {
    color: var(--link);
    text-decoration: none;
    font-weight: 600;
  }

  .authors-index__link a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
</style>
