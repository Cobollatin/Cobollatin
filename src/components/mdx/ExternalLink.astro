---
import type { HTMLAttributes } from 'astro/types';

import type { Locale } from '../../i18n/locales';

import { t } from '../../i18n/messages';
import { stripLocaleFromPath } from '../../i18n/routing';

type Props = HTMLAttributes<'a'> & {
  locale?: Locale;
};

const { locale: inferredLocale } = stripLocaleFromPath(Astro.url.pathname);
const { locale = inferredLocale, rel, target, ...properties } = Astro.props;
---

<a rel={rel ?? 'noreferrer noopener'} target={target ?? '_blank'} {...properties}>
  <slot />
  <span class="sr-only">({t(locale, 'ui.opensInNewTab')})</span>
</a>
