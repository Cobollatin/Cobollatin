---
import type { Locale } from '../i18n/locales';

import { CONTACT_EMAIL, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { localizePath } from '../i18n/routing';
import Layout from '../layouts/BlogPost.astro';

const locale: Locale = 'en';
---

<Layout
  description="About Cobollatin — portfolio, projects, and contact details."
  heroImage="/blog-placeholder-about.jpg"
  locale={locale}
  pubDate={new Date('2026-02-02')}
  title={`About ${SITE_TITLE}`}
  updatedDate={new Date('2026-02-02')}
>
  <section aria-label="Overview">
    <p>
      This is my personal website and portfolio. I publish my projects as blog entries, typically including context,
      screenshots, decisions, and links to code.
    </p>

    <p>
      If you’re an employer or recruiter, this page is the “shareable” version — a quick overview plus ways to verify my
      identity and contact me.
    </p>
  </section>

  <section aria-label="Quick links">
    <h2>Quick links</h2>
    <ul>
      <li>
        Portfolio (projects): <a href={localizePath('/blog', locale)}>{localizePath('/blog', locale)}</a>
      </li>
      <li>
        Authors: <a href={localizePath('/authors', locale)}>{localizePath('/authors', locale)}</a>
      </li>
    </ul>
  </section>

  <section aria-label="Recruiter summary">
    <h2>For employers / recruiters</h2>
    <p>
      If you’d like to reach out, email is best:{' '}
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
    <ul>
      <li>What I share: a portfolio of projects and write-ups (see the blog).</li>
      <li>What I value: clarity, maintainability, accessibility, and good developer experience.</li>
      <li>What I can provide on request: resume, references, and project/code samples.</li>
    </ul>
  </section>

  <section aria-label="Verification links">
    <h2>Verification links</h2>
    <p>
      I keep these accounts to reduce impersonation risk. I may not be active on all of them, but they should point back
      to the same identity.
    </p>
    <ul>
      {
        SOCIAL_LINKS.map((link) => (
          <li>
            <a href={link.href} rel="noreferrer noopener" target="_blank">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-label="Template">
    <h2>Template (copy/paste)</h2>
    <p class="muted">If you want a ready-to-send message, this is a simple template you can reuse.</p>
    <blockquote>
      <p>
        Hi — I’m {SITE_TITLE}. Here’s my portfolio: {localizePath('/blog', locale)}
      </p>
      <p>
        The best way to contact me is {CONTACT_EMAIL}. Thanks for your time!
      </p>
    </blockquote>
  </section>

  <style>
    .muted {
      color: var(--muted);
    }
  </style>
</Layout>
