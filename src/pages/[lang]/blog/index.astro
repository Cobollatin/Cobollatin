---
import { getCollection } from 'astro:content';

import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import { groupBlogEntries } from '../../../content/blog';
import { defaultLocale, type Locale, locales } from '../../../i18n/locales';
import { getLocaleFromParams } from '../../../i18n/routing';
import BaseHead from '../../../components/site/BaseHead.astro';
import Footer from '../../../components/site/Footer.astro';
import Header from '../../../components/site/Header.astro';

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((lang) => ({
      params: { lang },
    }));
}

const locale: Locale = getLocaleFromParams(Astro.params.lang);

const entries = await getCollection('blog');
const authors = await getCollection('authors');
const grouped = groupBlogEntries(entries);

const posts = Array.from(grouped.entries())
  .map(([translationKey, perLocale]) => ({
    entry: perLocale.get(locale) ?? perLocale.get(defaultLocale),
    translationKey,
  }))
  .filter((post): post is { entry: NonNullable<typeof post.entry>; translationKey: string } => Boolean(post.entry))
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf());
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead description={SITE_DESCRIPTION} locale={locale} title={SITE_TITLE} />
  </head>
  <body>
    <Header locale={locale} />
    <main id="main-content">
      <BlogIndex authors={authors} locale={locale} posts={posts} />
    </main>
    <Footer />
  </body>
</html>
