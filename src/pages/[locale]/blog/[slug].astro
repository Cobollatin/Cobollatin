---
import { getEntries, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { localePath, type Locale, messages } from '../../../lib/i18n';
import { entrySlug, publishedPosts, translatedPath, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { locale: post.data.locale, slug: entrySlug(post) }, props: { post, posts } }));
}
interface Props { post: Post; posts: Post[] }
const { post, posts } = Astro.props;
const locale = post.data.locale as Locale;
const { Content } = await render(post);
const authors = await getEntries(post.data.authors);
const alternatePaths = {
  en: locale === 'en' ? Astro.url.pathname : translatedPath(post, posts, 'blog', 'en'),
  es: locale === 'es' ? Astro.url.pathname : translatedPath(post, posts, 'blog', 'es'),
};
---
<Base locale={locale} title={post.data.title} description={post.data.description} alternatePaths={alternatePaths}>
  <article class="page"><p class="eyebrow"><a href={localePath(locale, 'blog/')}>{messages[locale].blog}</a></p><h1>{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    <p class="meta"><time datetime={post.data.publishedAt.toISOString()}>{new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(post.data.publishedAt)}</time> · {messages[locale].by} {authors.map((author) => author.data.name).join(', ')}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>
