---
import Base from '../../../layouts/Base.astro';
import { locales, messages, localePath, type Locale } from '../../../lib/i18n';
import { publishedPages, entrySlug } from '../../../lib/posts';

export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = messages[locale];
const pages = await publishedPages(locale);
---
<Base locale={locale} title={t.pages} description={t.pages}>
  <div class="page"><h1>{t.pages}</h1>
    {pages.length ? <div class="cards">{pages.map((page) => <a class="card" href={localePath(locale, `pages/${entrySlug(page)}/`)}><h2>{page.data.title}</h2><p>{page.data.description}</p></a>)}</div> : <p class="empty-state">{t.noPages}</p>}
  </div>
</Base>
