---
import { localePath } from '../lib/i18n';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#161616" />
    <title>Cobollatin</title>
    <script is:inline>try { if (localStorage.getItem('cobollatin-theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch {} document.querySelector('meta[name="theme-color"]')?.setAttribute('content', document.documentElement.dataset.theme === 'light' ? '#ffffff' : '#161616');</script>
    <script is:inline>
      let selected = 'en';
      let saved = null;
      try { saved = localStorage.getItem('cobollatin-locale'); } catch {}
      if (saved === 'en' || saved === 'es') selected = saved;
      else {
        try {
          const languages = navigator.languages?.length ? navigator.languages : [navigator.language || ''];
          selected = languages.map((value) => value.toLowerCase().split('-')[0]).find((value) => value === 'en' || value === 'es') || 'en';
        } catch {}
      }
      window.location.replace(`/${selected}/`);
    </script>
    <style>html{background:#161616;color:#f4f4f4;font-family:system-ui}html[data-theme=light]{background:#ffffff;color:#161616}body{min-height:80vh;display:grid;place-content:center;margin:0;padding:2rem}a{color:#78a9ff}a:focus-visible{outline:2px solid #ffffff;outline-offset:4px}html[data-theme=light] a{color:#0f62fe}html[data-theme=light] a:focus-visible{outline-color:#0f62fe}</style>
  </head>
  <body><a href={localePath('en')}>Cobollatin</a></body>
</html>
