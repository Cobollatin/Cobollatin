---
import { type CollectionEntry, getCollection } from 'astro:content';
import { render } from 'astro:content';

import { mdxComponents } from '../../components/mdx/mdxComponents';
import { groupBlogEntries, pickBlogEntry } from '../../content/blog';
import { defaultLocale, type Locale } from '../../i18n/locales';
import BlogPost from '../../layouts/BlogPost.astro';

type Props = {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
};

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  const grouped = groupBlogEntries(entries);

  return Array.from(grouped.keys())
    .map((translationKey) => {
      const entry = pickBlogEntry(grouped, translationKey, defaultLocale);
      if (!entry) return undefined;
      return {
        params: { slug: translationKey },
        props: { entry, locale: defaultLocale as Locale },
      };
    })
    .filter((v): v is NonNullable<typeof v> => Boolean(v));
}

const { entry, locale } = Astro.props as Props;
const { Content } = await render(entry);
---

<BlogPost {...entry.data} locale={locale}>
  <Content components={mdxComponents} />
</BlogPost>
